---

<Layout
  title="Neeraj Mukta | Links, Projects & Resume"
  description="All important links in one place: explore Neeraj Mukta's featured projects, technical portfolio, ventures, resume, and schedule a call."
  ogTitle="Neeraj Mukta - Bio Links & Projects"
  ogDescription="Product Engineer building AI-powered digital experiences with modern JavaScript and web technologies."
>
  <!-- Background Glow Accents -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
    <div
      class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] md:w-[700px] md:h-[700px] bg-gradient-to-tr from-primary-500/15 via-purple-500/10 to-secondary-500/15 rounded-full blur-3xl dark:opacity-40 animate-pulse"
      style="animation-duration: 8s;"
    ></div>
    <div
      class="absolute bottom-10 right-1/4 w-[400px] h-[400px] bg-secondary-500/10 dark:bg-secondary-500/5 rounded-full blur-3xl"
    ></div>
    <div
      class="absolute top-2/3 left-10 w-[350px] h-[350px] bg-pink-500/10 dark:bg-pink-500/5 rounded-full blur-3xl"
    ></div>
  </div>

  <section class="min-h-screen py-24 md:py-32">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <!-- Profile Header Card -->
      <div
        class="relative p-6 sm:p-8 rounded-3xl bg-white/75 dark:bg-dark-900/70 backdrop-blur-xl border border-gray-200/70 dark:border-white/10 shadow-xl shadow-gray-200/40 dark:shadow-black/40 text-center transition-all duration-300"
      >
        <!-- Top Action Bar (Share & QR Code) -->
        <div class="absolute top-4 right-4 flex items-center gap-2">
          <button
            id="qr-modal-btn"
            type="button"
            class="p-2.5 rounded-full bg-gray-100 dark:bg-dark-800 text-dark-700 dark:text-dark-200 hover:bg-primary-50 dark:hover:bg-primary-950/40 hover:text-primary-600 dark:hover:text-primary-400 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500"
            aria-label="View QR Code"
            title="Scan QR Code"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
          </button>
          <button
            id="share-profile-btn"
            type="button"
            class="p-2.5 rounded-full bg-gray-100 dark:bg-dark-800 text-dark-700 dark:text-dark-200 hover:bg-primary-50 dark:hover:bg-primary-950/40 hover:text-primary-600 dark:hover:text-primary-400 transition-colors focus:outline-none focus:ring-2 focus:ring-primary-500"
            aria-label="Share Linktree"
            title="Share Profile"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </button>
        </div>

        <!-- Avatar with Glowing Ring -->
        <div class="relative inline-block mx-auto mb-4 group">
          <div
            class="absolute -inset-1.5 bg-gradient-to-r from-primary-500 via-purple-500 to-secondary-500 rounded-full blur opacity-75 group-hover:opacity-100 transition duration-500 animate-pulse"
          ></div>
          <div
            class="relative w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden border-4 border-white dark:border-dark-900 shadow-lg bg-gray-100 dark:bg-dark-800"
          >
            <Image
              src={avatar}
              alt="Neeraj Mukta"
              width={256}
              height={256}
              class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-500"
              loading="eager"
            />
          </div>
          <!-- Verified Badge -->
          <span
            class="absolute bottom-1 right-1 p-1 bg-primary-600 text-white rounded-full shadow-md border-2 border-white dark:border-dark-900"
            title="Verified Profile"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-3.5 h-3.5"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </span>
        </div>

        <!-- Name & Handle -->
        <h1 class="text-2xl sm:text-3xl font-display font-extrabold tracking-tight">
          Neeraj Mukta
        </h1>
        <p class="text-sm font-medium text-primary-600 dark:text-primary-400 mt-0.5">
          @neeraj_builds • @fullstackNRJ
        </p>

        <!-- Bio Description -->
        <div class="mt-3.5 max-w-xl mx-auto space-y-2 text-center">
          <p class="text-dark-800 dark:text-dark-200 text-sm sm:text-base font-medium leading-relaxed">
            I’m a Product Engineer building AI-powered digital experiences with modern JavaScript and web technologies.
          </p>
          <p class="text-dark-600 dark:text-dark-400 text-xs sm:text-sm leading-relaxed">
            I bridge product thinking, design, and engineering to turn ideas into intuitive, high-impact products that solve real problems — from intelligent interfaces to scalable, production-ready applications.
          </p>
        </div>

        <!-- Status Badges -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-4">
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/30"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
            <span class="w-2 h-2 rounded-full bg-emerald-500 -ml-3.5"></span>
            Available for Projects
          </span>
          <span
            class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-gray-100 dark:bg-dark-800 text-dark-600 dark:text-dark-300 border border-gray-200 dark:border-dark-700"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-3.5 h-3.5 text-red-500"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                clip-rule="evenodd"></path>
            </svg>
            Bengaluru, India
          </span>
        </div>

        <!-- Social Icons Row -->
        <div class="flex items-center justify-center gap-3 sm:gap-4 mt-6 pt-5 border-t border-gray-100 dark:border-dark-800">
          {
            socials.map((soc) => (
              <a
                href={soc.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2.5 rounded-full bg-gray-100/80 dark:bg-dark-800/80 text-dark-700 dark:text-dark-300 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-950/40 transform hover:-translate-y-0.5 transition-all duration-200"
                aria-label={soc.name}
                title={soc.name}
              >
                {soc.icon === "github" && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                      fill-rule="evenodd"
                      d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                      clip-rule="evenodd"
                    />
                  </svg>
                )}
                {soc.icon === "twitter" && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
                  </svg>
                )}
                {soc.icon === "linkedin" && (
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                  </svg>
                )}
                {soc.icon === "calendar" && (
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                  </svg>
                )}
                {soc.icon === "mail" && (
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
