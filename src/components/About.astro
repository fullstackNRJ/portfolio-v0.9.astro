---

---

<section id="about" class="section bg-gray-50 dark:bg-dark-900/30">
  <div class="container">
    <h2 class="section-title text-center">
      About <span class="gradient-text">Me</span>
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div class="relative">
        <div class="relative z-10 overflow-hidden rounded-xl">
          <img
            src="https://images.pexels.com/photos/4974914/pexels-photo-4974914.jpeg"
            alt="Neeraj working on code"
            class="w-full h-full object-cover rounded-xl transform transition-transform hover:scale-105 duration-700"
          />
        </div>
        <div
          class="absolute -left-5 -bottom-5 w-24 h-24 bg-primary-500 rounded-xl z-0"
        >
        </div>
        <div
          class="absolute -right-5 -top-5 w-24 h-24 bg-secondary-500 rounded-xl z-0"
        >
        </div>
      </div>

      <div class="space-y-6">
        <p class="text-lg text-dark-700 dark:text-dark-300">
          Hey, I’m Neeraj — a <span class="highlight">Product Engineer</span> passionate
          about turning ideas into useful, well-crafted digital products.
        </p>

        <p class="text-lg text-dark-700 dark:text-dark-300">
          With <span class="highlight">10+ years of experience</span> in software
          development, I’ve worked across the full product lifecycle — from exploring
          ideas and prototyping experiences to building, shipping, and iterating on
          production-ready web and mobile applications.
        </p>

        <p class="text-lg text-dark-700 dark:text-dark-300">
          My core strength is the <span class="highlight">JavaScript</span> ecosystem,
          with experience across <span class="highlight">React</span>, Next.js,
          Angular, Node.js, and modern cloud platforms. More recently, I’ve been
          focused on building <span class="highlight"
            >AI-powered products and experiences</span
          >, exploring LLMs, AI agents, intelligent interfaces, and practical
          ways to bring AI into real-world products.
        </p>

        <p class="text-lg text-dark-700 dark:text-dark-300">
          I also use tools like <span class="highlight">Webflow</span>, <span
            class="highlight">Bubble</span
          >, and <span class="highlight">Framer</span> to prototype and validate ideas
          quickly. I believe the best technology is the one that helps solve the problem
          effectively — whether that means writing custom software or using a no-code/low-code
          approach.
        </p>

        <p class="text-lg text-dark-700 dark:text-dark-300">
          What drives me is the intersection of <span class="highlight"
            >product, design, engineering, and AI</span
          >. I enjoy breaking down complex problems, simplifying experiences,
          and building products that people genuinely find useful.
        </p>

        <p class="text-lg text-dark-700 dark:text-dark-300">
          Outside of building products, I enjoy exploring emerging technologies,
          contributing to open source, and sharing what I learn through writing
          and tutorials.
        </p>

        <div class="pt-4">
          <h3
            class="text-2xl font-extrabold mb-4 text-primary-600 dark:text-secondary-400"
          >
            Key Highlights
          </h3>
          <ul class="space-y-3">
            <li class="flex items-start font-bold text-lg">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-primary-500 mr-2 flex-shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span>10+ years of experience in web and mobile development</span>
            </li>
            <li class="flex items-start font-bold text-lg">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-primary-500 mr-2 flex-shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Created 30+ successful projects for various clients</span>
            </li>
            <li class="flex items-start font-bold text-lg">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-primary-500 mr-2 flex-shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Open source contributor and tech community mentor</span>
            </li>
            <li class="flex items-start font-bold text-lg">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-primary-500 mr-2 flex-shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
              <span>Constantly learning and exploring new technologies</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("DOMContentLoaded", () => {
    gsap.from("#about img", {
      scrollTrigger: {
        trigger: "#about",
        start: "top 80%",
      },
      duration: 1,
      scale: 0.8,
      opacity: 0,
      ease: "power3.out",
    });

    gsap.from("#about p, #about h3, #about li", {
      scrollTrigger: {
        trigger: "#about",
        start: "top 70%",
      },
      duration: 0.8,
      y: 30,
      opacity: 0,
      stagger: 0.2,
      ease: "power3.out",
    });
  });
</script>
